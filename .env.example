# .env.example — copiar como .env antes de arrancar
# IMPORTANTE: el fichero .env NUNCA se sube al repositorio (.gitignore)
# ── Módulos activos ──────────────────────────────────────────────────
# Desactivar los costosos en desarrollo para arranques más rápidos.
ENABLE_ELA=true
ENABLE_NOISE=true
ENABLE_SHARPNESS=true
ENABLE_COPY_MOVE=false    # costoso: activar solo cuando se necesite
ENABLE_JPEG=true
ENABLE_METADATA=true
# ── Parámetros ELA ───────────────────────────────────────────────────
# Calidad 50-99: menor valor → más sensible pero más falsos positivos.
ELA_QUALITY=90
# Factor 1-30: amplifica visualmente las diferencias en el mapa ELA.
ELA_AMPLIFY=15
# Tamaño del bloque (px) para detectar regiones anómalas.
ELA_REGION_BLOCK=64
# Umbral en desviaciones estándar para marcar una región como anómala.
ELA_REGION_SIGMA=2.5
# ── Parámetros Noise ─────────────────────────────────────────────────
NOISE_BLOCK_SIZE=32
NOISE_THRESHOLD_SIGMA=2.0
# ── Parámetros Sharpness ─────────────────────────────────────────────
SHARP_BLOCK_SIZE=32
SHARP_ANOMALY_SIGMA=2.5
# ── Pesos del scoring ────────────────────────────────────────────────
# Los pesos visuales deben sumar <= 1.0.
# Las señales visuales pesan más que los metadatos.
SCORE_WEIGHT_ELA=0.22
SCORE_WEIGHT_NOISE=0.18
SCORE_WEIGHT_JPEG=0.15
SCORE_WEIGHT_EDGE=0.10
SCORE_WEIGHT_BLUR=0.10
SCORE_WEIGHT_RESAMP=0.10
SCORE_WEIGHT_COPYMOVE=0.15
# Contribución máxima de los metadatos al score final.
SCORE_META_BONUS=0.20
# Cap cuando solo hay señales de metadatos sin señales visuales.
SCORE_META_ONLY_CAP=0.55
# ── Thresholds de decisión ───────────────────────────────────────────
# Deben cumplir: MEDIUM < HIGH < MANUAL <= 1.0
# [0.00, MEDIUM)  → low_suspicion
# [MEDIUM, HIGH)  → medium_suspicion
# [HIGH, MANUAL)  → high_suspicion
# [MANUAL, 1.00]  → manual_review_required
THRESHOLD_MEDIUM=0.31
THRESHOLD_HIGH=0.61
THRESHOLD_MANUAL=0.81
# ── Sistema ──────────────────────────────────────────────────────────
OUTPUT_DIR=/outputs
# Usar DEBUG durante el desarrollo para ver el detalle de cada módulo.
LOG_LEVEL=INFO
