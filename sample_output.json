import base64
import json
import subprocess
from pathlib import Path

def main():
    # Make a tiny authentic dummy image
    from PIL import Image
    import io
    img = Image.new('RGB', (256, 256), color = 'red')
    buf = io.BytesIO()
    img.save(buf, format='JPEG', quality=90)
    b64 = base64.b64encode(buf.getvalue()).decode()

    req = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
            "name": "analizar_imagen",
            "arguments": {
                "imagen_base64": b64
            }
        }
    }

    print("Para probar con MCP Inspector:")
    print("npx @modelcontextprotocol/inspector docker compose -f ../docker-compose.yml run --rm -i mcp-forgery-detector")
    print("\nEjemplo de payload para llamar a la tool:")
    print(json.dumps(req, indent=2))

if __name__ == '__main__':
    main()
